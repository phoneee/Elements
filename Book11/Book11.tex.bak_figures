{\large \ggn{2}.}
\end{center}\vspace*{-7pt}

\gr{Ἐὰν δύο εὐθεῖαι τέμνωσιν ἀλλήλας, ἐν ἑνί εἰσιν
ἐπιπέδῳ, καὶ πᾶν τρίγωνον ἐν ἑνί ἐστιν ἐπιπέδῳ.}\\

