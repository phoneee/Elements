\begin{center}
{\large \ggn{5}.}
\end{center}\vspace*{-7pt}

\gr{Ἐὰν δύο τρίγωνα τὰξ πλευρὰξ ἀνάλογον >έθῃ, ἰσογώνια
>έσται τὰ τρίγωνα καὶ >ίσαξ <έχει τὰξ γωνίαξ, ὑφ> <ὰξ αἱ
