\gr{Δύο μέσα δυναμένην,}\vspace*{-7pt}

\gr{Ἀποτομήν,}\vspace*{-7pt}

\gr{Μἑσης ἀποτομὴν πρώτην,}\vspace*{-7pt}

\gr{Μἑσης ἀποτομὴν δευτέραν,}\vspace*{-7pt}

\gr{Ἐλάσσονα},\vspace*{-7pt}

\gr{Μετὰ ὁρητοῦ μέσον τὸ ὅλον ποιοῦσαν,}\vspace*{-7pt}

\gr{Μετὰ μέσου μέσον τὸ ὅλον ποιοῦσαν.}}

\ParallelRText{

Medial,\vspace*{-7pt}

Binomial,\vspace*{-7pt}

First bimedial,\vspace*{-7pt}

Second bimedial,\vspace*{-7pt}

Major,\vspace*{-7pt}

Square-root of a rational plus a medial (area),\vspace*{-7pt}

Square-root of (the sum of) two medial (areas),\vspace*{-7pt}

